<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="@color/menu_channel_bg_selected" />
            <stroke
                android:width="1dp"
                android:color="@color/menu_channel_border_selected" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="@color/menu_channel_bg_focused" />
            <stroke
                android:width="1dp"
                android:color="@color/menu_channel_border_focused" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="@color/menu_channel_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/menu_channel_border" />
        </shape>
    </item>
</selector>
