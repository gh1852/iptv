<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="#4FFFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#59FFFFFF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="#36FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#73FFFFFF" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="#0FFFFFFF" />
            <stroke
                android:width="1dp"
                android:color="@color/item_stroke_subtle" />
        </shape>
    </item>
</selector>
